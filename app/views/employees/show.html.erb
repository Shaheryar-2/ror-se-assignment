<div class="container">
  <h1><%= @employee.dig("name") %>'s Details</h1>

  <table class="table">
    <tr>
      <th>Name</th>
      <td><%= @employee.dig("name") %></td>
    </tr>
    <tr>
      <th>Position</th>
      <td><%= @employee.dig("position") %></td>
    </tr>
    <tr>
      <th>Salary</th>
      <td><%= @employee.dig("salary") %></td>
    </tr>
    <tr>
      <th>Date of Birth</th>
      <td><%= @employee.dig("date_of_birth") %></td>
    </tr>
  </table>

  <%= link_to 'Edit', edit_employee_path(@employee.dig("id")), class: 'btn btn-secondary' %>
  <%= link_to 'Back', employees_path, class: 'btn btn-primary' %>
</div>
